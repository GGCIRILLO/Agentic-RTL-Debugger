# Temporal server address (default: local dev server)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rtl-debug-queue

# LLM provider (openai | anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o

# Paths
CASES_DIR=cases
OUTPUTS_DIR=outputs
