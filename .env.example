# Temporal server address (default: local dev server)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rtl-debug-queue

# ---------------------------------------------------------------------------
# LLM provider — choose one: ollama | openai | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Ollama (local, recommended for M-series Macs) --------------------------
# Install: brew install ollama
# Pull model: ollama pull qwen2.5-coder:7b
# Start server: ollama serve  (runs on :11434 by default)
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OpenAI (remote, requires API key) -------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# --- Anthropic (remote, requires API key) ----------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Max JSON parse retries before letting Temporal retry the whole activity
LLM_JSON_MAX_RETRIES=3

# Paths
CASES_DIR=cases
OUTPUTS_DIR=outputs
