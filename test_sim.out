S_0x104916d30 .scope module, "tb_counter" "tb_counter" 2 10;
 .timescale -9 -12;
v0x10491d900_0 .var "clk", 0 0;
v0x10491d9a0_0 .net "count", 3 0, v0x104914b00_0;  1 drivers
v0x10491da40_0 .var/i "errors", 31 0;
v0x10491dae0_0 .var "rst", 0 0;
