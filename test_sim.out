 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 4 "count";
v0x104914a60_0 .net "clk", 0 0, v0x10491d900_0;  1 drivers
v0x104914b00_0 .var "count", 3 0;
v0x10491d860_0 .net "rst", 0 0, v0x10491dae0_0;  1 drivers
E_0xb77000300 .event posedge, v0x104914a60_0;
    .scope S_0x1049148e0;
T_0 ;
    %wait E_0xb77000300;
    %load/vec4 v0x10491d860_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x104914b00_0, 0;
T_0.0 ;
    %load/vec4 v0x104914b00_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x104914b00_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x104916d30;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10491d900_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x104916d30;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x10491d900_0;
    %inv;
    %store/vec4 v0x10491d900_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x104916d30;
T_3 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x10491da40_0, 0, 32;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x10491dae0_0, 0, 1;
    %pushi/vec4 3, 0, 32;
T_3.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %subi 1, 0, 32;
    %wait E_0xb77000300;
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %load/vec4 v0x10491d9a0_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_3.2, 6;
    %vpi_call 2 48 "$display", "FAILED: expected count=0 after reset, got count=%0d", v0x10491d9a0_0 {0 0 0};
    %load/vec4 v0x10491da40_0;
    %addi 1, 0, 32;
    %store/vec4 v0x10491da40_0, 0, 32;
T_3.2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10491dae0_0, 0, 1;
    %pushi/vec4 8, 0, 32;
T_3.4 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_3.5, 5;
    %jmp/1 T_3.5, 4;
    %subi 1, 0, 32;
    %wait E_0xb77000300;
    %delay 1000, 0;
    %jmp T_3.4;
T_3.5 ;
    %pop/vec4 1;
    %load/vec4 v0x10491d9a0_0;
    %cmpi/ne 8, 0, 4;
    %jmp/0xz  T_3.6, 6;
    %vpi_call 2 61 "$display", "FAILED: expected count=8 after 8 increments, got count=%0d", v0x10491d9a0_0 {0 0 0};
    %load/vec4 v0x10491da40_0;
    %addi 1, 0, 32;
    %store/vec4 v0x10491da40_0, 0, 32;
T_3.6 ;
    %load/vec4 v0x10491da40_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.8, 4;
    %vpi_call 2 69 "$display", "PASSED: all checks passed" {0 0 0};
    %jmp T_3.9;
T_3.8 ;
    %vpi_call 2 71 "$display", "FAILED: %0d error(s) found", v0x10491da40_0 {0 0 0};
T_3.9 ;
    %vpi_call 2 73 "$finish" {0 0 0};
    %end;
    .thread T_3;
